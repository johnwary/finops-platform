# App
NODE_ENV=development
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/finops_platform_db

# Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

# Web
WEB_URL=http://localhost:5173
# Set only in prod when the web app and API are on split subdomains
# (e.g. finops.example.com / api.finops.example.com). Leave unset for
# same-origin/dev — do not hardcode a domain in code.
COOKIE_DOMAIN=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@mail.johnwary.cloud
